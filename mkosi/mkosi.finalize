#!/bin/bash
set -e

#
# Select the desired key type for the key / certificate to be created
#
# In the following, these definitions are used:
#
# <ML-DSA type> is one of:
#   ML-DSA87
#   ML-DSA65
#   ML-DSA44
#
# <SLH-DSA type> is one of:
#   SLH-DSA-SHAKE-256S
#   SLH-DSA-SHAKE-256F
#   SLH-DSA-SHAKE-192S
#   SLH-DSA-SHAKE-192F
#   SLH-DSA-SHAKE-128S
#   SLH-DSA-SHAKE-128F
#
# <classic type> is one of:
#   ED448
#   ED25519

# ML-DSA Composite keys are specified by a string: <ML-DSA type>-<classic type>
KEYTYPE="ML-DSA87"

# ML-DSA keys are specified by a string: <ML-DSA type>
#KEYTYPE="ML-DSA65-ED25519"

# SLH-DSA keys are specified by a string: <SLH-DSA type>
#KEYTYPE="SLH-DSA-SHAKE-256S"

touch -r "$BUILDROOT/usr" "$BUILDROOT/etc/.updated" "$BUILDROOT/var/.updated"

mkdir -p "$OUTPUTDIR/mok/"

# PEM files
keyfile="$OUTPUTDIR/mok/mkosi.pem.key"
certfile="$OUTPUTDIR/mok/mkosi.pem"

# DER files
keyfile_der="$OUTPUTDIR/mok/mkosi.key"
certfile_der="$OUTPUTDIR/mok/mkosi.crt"

# The following command is intended with leancrypto 1.7.0, because the
# generated keys are picked up by OpenSSL via sbsign and thus require a private
# key formatted according to PKCS#8
LD_LIBRARY_PATH=$BUILDDIR/usr/local/lib:$BUILDDIR/usr/local/lib64	\
$BUILDDIR/usr/local/bin/lc_x509_generator				\
  --keyusage keyCertSign						\
  --keyusage critical							\
  --eku codeSigning							\
  --subject-cn "mkosi MOK key"						\
  --san-dns "mkosi.local"						\
  --ca									\
  --outfile "$certfile"							\
  --sk-file "$keyfile"							\
  --valid-days 3650							\
  --create-keypair-pkcs8 ${KEYTYPE}					\
  --pem-output

#openssl genpkey -algorithm ML-DSA-87 -outform DER -out $OUTPUTDIR/mok/mkosi.key
#openssl req -new -key $OUTPUTDIR/mok/mkosi.key -outform DER -out "$OUTPUTDIR/mok/mkosi.csr" -subj "/CN=mkosi MOK key" -addext "subjectAltName=DNS:mkosi.local"
#openssl x509 -req -in "$OUTPUTDIR/mok/mkosi.csr" -signkey $OUTPUTDIR/mok/mkosi.key -out "$OUTPUTDIR/mok/mkosi.crt" -outform DER -days 3650

chmod 0644 "$certfile"
chmod 0600 "$keyfile"

#openssl x509 -in $OUTPUTDIR/mok/mkosi.crt -inform DER -noout -text
#openssl pkcs8 -in "$OUTPUTDIR/mok/mkosi.key" -inform DER -out "$OUTPUTDIR/mok/mkosi.key.pem" -outform PEM -nocrypt

# Print certificate
LD_LIBRARY_PATH=$BUILDDIR/usr/local/lib:$BUILDDIR/usr/local/lib64	\
$BUILDDIR/usr/local/bin/lc_x509_generator				\
  --print-x509 $certfile

# Convert certificate PEM -> DER
LD_LIBRARY_PATH=$BUILDDIR/usr/local/lib:$BUILDDIR/usr/local/lib64	\
$BUILDDIR/usr/local/bin/lc_x509_generator				\
  --convert								\
  --x509-signer $certfile						\
  --outfile $certfile_der

# Convert secret key PEM -> DER
LD_LIBRARY_PATH=$BUILDDIR/usr/local/lib:$BUILDDIR/usr/local/lib64	\
$BUILDDIR/usr/local/bin/lc_x509_generator				\
  --convert								\
  --signer-sk-file $keyfile						\
  --sk-file $keyfile_der

mkdir -p "$BUILDROOT/boot/loader/addons"
PATH=$BUILDDIR/usr/local/libexec/leancrypto:$PATH			\
LD_LIBRARY_PATH=$BUILDDIR/usr/local/lib:$BUILDDIR/usr/local/lib64	\
ukify build								\
    --stub "$BUILDROOT/usr/lib/systemd/boot/efi/addon${EFI_ARCHITECTURE}.efi.stub" \
    --cmdline="foobarbaz"						\
    --output "$BUILDROOT/boot/loader/addons/test.addon.efi"		\
    --secureboot-certificate "$certfile"				\
    --secureboot-private-key "$keyfile"
