#!/bin/bash
set -e

if [ "$ARCHITECTURE" = "x86-64" ]; then
    EFI_ARCHITECTURE="x64"
elif [ "$ARCHITECTURE" = "x86" ]; then
    EFI_ARCHITECTURE="ia32"
elif [ "$ARCHITECTURE" = "arm64" ]; then
    EFI_ARCHITECTURE="aa64"
else
    EFI_ARCHITECTURE="$ARCHITECTURE"
fi

cd "$BUILDDIR"

#
# Build library for the lc_*_generator tools
# - do not compile the tests
# - install the compilation so that libleancrypto.so and the tools are installed
#   into the build root to be available to the whole system
#
meson setup leancrypto-build $SRCDIR/leancrypto/ -Dtests=disabled -Dsbsigntools=enabled -Dbuildtype=release
meson compile -C leancrypto-build
meson install -C leancrypto-build --destdir $BUILDDIR

#
# Build library for linking with shim
# - install the compilation to ensure that the correct header files are found
#   by the shim compilation into the build directory
#
$SRCDIR/leancrypto/build-scripts/shim_support.sh $SRCDIR/leancrypto/
meson compile -C leancrypto-build-shim
meson install -C leancrypto-build-shim --destdir $BUILDDIR

openssl x509 -inform PEM -in "$SRCDIR/mkosi/mkosi.conf.d/$DISTRIBUTION/certs/shim.crt" -outform DER -out shim.der

export VENDOR_CERT_FILE=$PWD/shim.der
export EFIDIR=$DISTRIBUTION
export DEBUG=1

make TOPDIR="$SRCDIR" -f "$SRCDIR/Makefile" -j1

for b in shim fb mm; do
    install -D "${b}${EFI_ARCHITECTURE}.efi" -t "$DESTDIR/usr/lib/shim/" -m 0755
done
